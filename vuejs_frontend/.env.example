# Copy this file to `.env` and set values for your environment.

# Base URL of the FastAPI backend (required for login to work when frontend and backend are on different hosts/ports)
# Examples:
#   Local dev: http://localhost:3001
#   Kavia environment: https://vscode-internal-41630-beta.beta01.cloud.kavia.ai:3001
VITE_API_BASE_URL="http://localhost:3001"

# Optional: prefix for localStorage keys
VITE_APP_STORAGE_PREFIX="smp_"

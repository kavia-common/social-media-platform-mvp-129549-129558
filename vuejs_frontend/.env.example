# PUBLIC_INTERFACE
# Example environment variables for the Vue frontend.
# Copy this file to .env and adjust values for your environment.

# Base URL of the FastAPI backend. Must include protocol and host (and port if non-80/443).
# For local dev where backend runs on port 3001:
# VITE_API_BASE_URL="http://localhost:3001"
# In the Kavia environment, the backend is exposed at the same host with port 3001. Example:
# VITE_API_BASE_URL="https://vscode-internal-41630-beta.beta01.cloud.kavia.ai:3001"
VITE_API_BASE_URL="https://vscode-internal-41630-beta.beta01.cloud.kavia.ai:3001"

# Optional: prefix for localStorage keys to avoid collisions across apps.
VITE_APP_STORAGE_PREFIX="smp_"
